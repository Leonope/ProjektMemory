{"ast":null,"code":"export default {\n  name: 'GameSetup',\n  props: {\n    playerName: {\n      type: String,\n      default: ''\n    },\n    playerCount: {\n      type: Number,\n      default: 1\n    },\n    pairs: {\n      type: Number,\n      default: 4\n    }\n  },\n  emits: ['update:playerName', 'update:playerCount', 'update:pairs', 'start']\n};","map":{"version":3,"names":["name","props","playerName","type","String","default","playerCount","Number","pairs","emits"],"sources":["C:\\Users\\leo11\\OneDrive\\Desktop\\HTWG\\AIN\\Semester5\\Web-apps\\vue\\ProjektMemory\\src\\components\\memory\\GameSetup.vue"],"sourcesContent":["<template>\r\n  <div class=\"game-setup-container\">\r\n    <h1 class=\"mb-4 text-center\">Memory – Vue SPA</h1>\r\n\r\n    <div class=\"alert alert-info text-center mb-3\">\r\n      Wähle Name, Spieleranzahl und Anzahl Paare für die Vue-Version.\r\n    </div>\r\n\r\n    <form @submit.prevent=\"$emit('start')\" class=\"row g-3 mb-4 justify-content-center\">\r\n      <div class=\"col-12 col-md-4\">\r\n        <label for=\"playerName\" class=\"form-label\">Name</label>\r\n        <input\r\n          id=\"playerName\"\r\n          type=\"text\"\r\n          class=\"form-control\"\r\n          :value=\"playerName\"\r\n          @input=\"$emit('update:playerName', $event.target.value)\"\r\n          placeholder=\"Dein Name\"\r\n        >\r\n      </div>\r\n\r\n      <div class=\"col-12 col-md-4\">\r\n        <label for=\"pairs\" class=\"form-label\">Anzahl Paare</label>\r\n        <input\r\n          id=\"pairs\"\r\n          type=\"number\"\r\n          min=\"2\"\r\n          max=\"18\"\r\n          step=\"2\"\r\n          class=\"form-control\"\r\n          :value=\"pairs\"\r\n          @input=\"$emit('update:pairs', parseInt($event.target.value || '2', 10))\"\r\n        >\r\n      </div>\r\n\r\n      <div class=\"col-12 col-md-4\">\r\n        <label for=\"playerCount\" class=\"form-label\">Anzahl Spieler</label>\r\n        <select\r\n          id=\"playerCount\"\r\n          class=\"form-select\"\r\n          :value=\"playerCount\"\r\n          @change=\"$emit('update:playerCount', parseInt($event.target.value || '1', 10))\"\r\n        >\r\n          <option :value=\"1\">1</option>\r\n          <option :value=\"2\">2</option>\r\n          <option :value=\"3\">3</option>\r\n          <option :value=\"4\">4</option>\r\n        </select>\r\n      </div>\r\n\r\n      <div class=\"col-12 text-center\">\r\n        <button type=\"submit\" class=\"btn btn-primary px-4\">\r\n          Vue-Spiel starten\r\n        </button>\r\n      </div>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'GameSetup',\r\n  props: {\r\n    playerName: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    playerCount: {\r\n      type: Number,\r\n      default: 1\r\n    },\r\n    pairs: {\r\n      type: Number,\r\n      default: 4\r\n    }\r\n  },\r\n  emits: ['update:playerName', 'update:playerCount', 'update:pairs', 'start']\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.game-setup-container {\r\n  max-width: 960px;\r\n  margin: 0 auto;\r\n}\r\n</style>\r\n"],"mappings":"AA4DA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,WAAW,EAAE;MACXH,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDG,KAAK,EAAE;MACLL,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX;EACF,CAAC;EACDI,KAAK,EAAE,CAAC,mBAAmB,EAAE,oBAAoB,EAAE,cAAc,EAAE,OAAO;AAC5E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}