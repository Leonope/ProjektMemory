{"ast":null,"code":"export default {\n  name: 'GameSetup',\n  props: {\n    playerName: {\n      type: String,\n      default: ''\n    },\n    playerCount: {\n      type: Number,\n      default: 1\n    },\n    pairs: {\n      type: Number,\n      default: 4\n    }\n  },\n  emits: ['update:playerName', 'update:playerCount', 'update:pairs', 'start']\n};","map":{"version":3,"names":["name","props","playerName","type","String","default","playerCount","Number","pairs","emits"],"sources":["/home/alex/Documents/Semester5/WebApplications/vue-memory/memory/src/components/memory/GameSetup.vue"],"sourcesContent":["<template>\n  <div class=\"game-setup-container\">\n    <h1 class=\"mb-4 text-center\">Memory – Vue SPA</h1>\n\n    <div class=\"alert alert-info text-center mb-3\">\n      Wähle Name, Spieleranzahl und Anzahl Paare für die Vue-Version.\n    </div>\n\n    <form @submit.prevent=\"$emit('start')\" class=\"row g-3 mb-4 justify-content-center\">\n      <div class=\"col-12 col-md-4\">\n        <label for=\"playerName\" class=\"form-label\">Name</label>\n        <input\n          id=\"playerName\"\n          type=\"text\"\n          class=\"form-control\"\n          :value=\"playerName\"\n          @input=\"$emit('update:playerName', $event.target.value)\"\n          placeholder=\"Dein Name\"\n        >\n      </div>\n\n      <div class=\"col-12 col-md-4\">\n        <label for=\"pairs\" class=\"form-label\">Anzahl Paare</label>\n        <input\n          id=\"pairs\"\n          type=\"number\"\n          min=\"2\"\n          max=\"18\"\n          step=\"2\"\n          class=\"form-control\"\n          :value=\"pairs\"\n          @input=\"$emit('update:pairs', parseInt($event.target.value || '2', 10))\"\n        >\n      </div>\n\n      <div class=\"col-12 col-md-4\">\n        <label for=\"playerCount\" class=\"form-label\">Anzahl Spieler</label>\n        <select\n          id=\"playerCount\"\n          class=\"form-select\"\n          :value=\"playerCount\"\n          @change=\"$emit('update:playerCount', parseInt($event.target.value || '1', 10))\"\n        >\n          <option :value=\"1\">1</option>\n          <option :value=\"2\">2</option>\n          <option :value=\"3\">3</option>\n          <option :value=\"4\">4</option>\n        </select>\n      </div>\n\n      <div class=\"col-12 text-center\">\n        <button type=\"submit\" class=\"btn btn-primary px-4\">\n          Vue-Spiel starten\n        </button>\n      </div>\n    </form>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'GameSetup',\n  props: {\n    playerName: {\n      type: String,\n      default: ''\n    },\n    playerCount: {\n      type: Number,\n      default: 1\n    },\n    pairs: {\n      type: Number,\n      default: 4\n    }\n  },\n  emits: ['update:playerName', 'update:playerCount', 'update:pairs', 'start']\n}\n</script>\n\n<style scoped>\n.game-setup-container {\n  max-width: 960px;\n  margin: 0 auto;\n}\n</style>\n"],"mappings":"AA4DA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,WAAW,EAAE;MACXH,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDG,KAAK,EAAE;MACLL,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX;EACF,CAAC;EACDI,KAAK,EAAE,CAAC,mBAAmB,EAAE,oBAAoB,EAAE,cAAc,EAAE,OAAO;AAC5E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}