{"ast":null,"code":"import { renderList as _renderList, Fragment as _Fragment, openBlock as _openBlock, createElementBlock as _createElementBlock, toDisplayString as _toDisplayString, createCommentVNode as _createCommentVNode, createTextVNode as _createTextVNode, createElementVNode as _createElementVNode, normalizeClass as _normalizeClass } from \"vue\";\nconst _hoisted_1 = {\n  class: \"board\"\n};\nconst _hoisted_2 = [\"onClick\"];\nconst _hoisted_3 = {\n  class: \"card-inner\"\n};\nconst _hoisted_4 = {\n  class: \"symbol\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($props.cards, (card, index) => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      class: \"card-wrapper\",\n      key: card.id\n    }, [_createElementVNode(\"button\", {\n      type: \"button\",\n      class: _normalizeClass(['memory-card', card.state]),\n      onClick: $event => _ctx.$emit('flip', index)\n    }, [_createElementVNode(\"div\", _hoisted_3, [_createElementVNode(\"span\", _hoisted_4, [_createTextVNode(_toDisplayString(card.state === 'facedown' ? '?' : card.symbol) + \" \", 1 /* TEXT */), _createCommentVNode(\" Falls du lieber die ID sehen willst:\\r\\n                 {{ card.state === 'facedown' ? '?' : card.id }} \")])])], 10 /* CLASS, PROPS */, _hoisted_2)]);\n  }), 128 /* KEYED_FRAGMENT */))]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_Fragment","_renderList","$props","cards","card","index","key","id","_createElementVNode","type","_normalizeClass","state","onClick","$event","_ctx","$emit","_hoisted_3","_hoisted_4","symbol","_createCommentVNode"],"sources":["C:\\Users\\leo11\\OneDrive\\Desktop\\HTWG\\AIN\\Semester5\\Web-apps\\vue\\ProjektMemory\\src\\components\\memory\\MemoryBoard.vue"],"sourcesContent":["<template>\r\n  <div class=\"board\">\r\n    <div\r\n      class=\"card-wrapper\"\r\n      v-for=\"(card, index) in cards\"\r\n      :key=\"card.id\"\r\n    >\r\n      <button\r\n        type=\"button\"\r\n        :class=\"['memory-card', card.state]\"\r\n        @click=\"$emit('flip', index)\"\r\n      >\r\n        <div class=\"card-inner\">\r\n          <span class=\"symbol\">\r\n            {{ card.state === 'facedown' ? '?' : card.symbol }}\r\n            <!-- Falls du lieber die ID sehen willst:\r\n                 {{ card.state === 'facedown' ? '?' : card.id }} -->\r\n          </span>\r\n        </div>\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'MemoryBoard',\r\n  props: {\r\n    cards: {\r\n      type: Array,\r\n      default: () => []\r\n    }\r\n  },\r\n  emits: ['flip']\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Grid-Layout */\r\n.board {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));\r\n  gap: 0.75rem;\r\n}\r\n\r\n.card-wrapper {\r\n  width: 100%;\r\n}\r\n\r\n/* Button als Karte */\r\n.memory-card {\r\n  position: relative;\r\n  width: 100%;\r\n  aspect-ratio: 3 / 4;\r\n  border: none;\r\n  padding: 0;\r\n  background: transparent;\r\n  cursor: pointer;\r\n  perspective: 1000px;\r\n}\r\n\r\n/* Kein Cursor für gematchte Karten */\r\n.memory-card.matched {\r\n  cursor: default;\r\n}\r\n\r\n/* Innenleben mit Flip-Effekt */\r\n.card-inner {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 100%;\r\n  border-radius: 0.6rem;\r\n  box-shadow: 0 0.35rem 0.8rem rgba(0, 0, 0, 0.15);\r\n  overflow: hidden;\r\n\r\n  background: #2c3e50;\r\n  color: #ecf0f1;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n\r\n  transform-style: preserve-3d;\r\n  transition:\r\n    transform 0.35s ease,\r\n    background 0.2s,\r\n    color 0.2s;\r\n}\r\n\r\n/* Flip-Animation abhängig vom state (per Klasse) */\r\n.memory-card.faceup .card-inner,\r\n.memory-card.matched .card-inner {\r\n  transform: rotateY(180deg);\r\n  background: #ffffff;\r\n  color: #2c3e50;\r\n}\r\n\r\n/* Gefundene Karten grün einfärben */\r\n.memory-card.matched .card-inner {\r\n  background: #d4edda;\r\n}\r\n\r\n/* Mini-Pop bei Match */\r\n.memory-card.matched .card-inner {\r\n  animation: matched-pop 0.25s ease-out;\r\n}\r\n\r\n.symbol {\r\n  font-size: 2rem;\r\n  font-weight: 800;\r\n}\r\n\r\n@keyframes matched-pop {\r\n  0% {\r\n    transform: rotateY(180deg) scale(1);\r\n  }\r\n  50% {\r\n    transform: rotateY(180deg) scale(1.07);\r\n  }\r\n  100% {\r\n    transform: rotateY(180deg) scale(1);\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,KAAK,EAAC;AAAO;;;EAWPA,KAAK,EAAC;AAAY;;EACfA,KAAK,EAAC;AAAQ;;uBAZ5BC,mBAAA,CAoBM,OApBNC,UAoBM,I,kBAnBJD,mBAAA,CAkBME,SAAA,QAAAC,WAAA,CAhBoBC,MAAA,CAAAC,KAAK,GAArBC,IAAI,EAAEC,KAAK;yBAFrBP,mBAAA,CAkBM;MAjBJD,KAAK,EAAC,cAAc;MAEnBS,GAAG,EAAEF,IAAI,CAACG;QAEXC,mBAAA,CAYS;MAXPC,IAAI,EAAC,QAAQ;MACZZ,KAAK,EAAAa,eAAA,iBAAkBN,IAAI,CAACO,KAAK;MACjCC,OAAK,EAAAC,MAAA,IAAEC,IAAA,CAAAC,KAAK,SAASV,KAAK;QAE3BG,mBAAA,CAMM,OANNQ,UAMM,GALJR,mBAAA,CAIO,QAJPS,UAIO,G,kCAHFb,IAAI,CAACO,KAAK,wBAAwBP,IAAI,CAACc,MAAM,IAAG,GACnD,iBAAAC,mBAAA,8GACwD,C","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}