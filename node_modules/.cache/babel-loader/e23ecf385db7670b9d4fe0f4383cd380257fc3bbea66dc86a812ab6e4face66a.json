{"ast":null,"code":"export default {\n  name: 'MemoryBoard',\n  props: {\n    cards: {\n      type: Array,\n      default: () => []\n    }\n  },\n  emits: ['flip']\n};","map":{"version":3,"names":["name","props","cards","type","Array","default","emits"],"sources":["/home/alex/Documents/Semester5/WebApplications/vue-memory/memory/src/components/memory/MemoryBoard.vue"],"sourcesContent":["<template>\n  <div class=\"board\">\n    <div\n      class=\"card-wrapper\"\n      v-for=\"(card, index) in cards\"\n      :key=\"card.id\"\n    >\n      <button\n        type=\"button\"\n        :class=\"['memory-card', card.state]\"\n        @click=\"$emit('flip', index)\"\n      >\n        <div class=\"card-inner\">\n          <span class=\"symbol\">\n            {{ card.state === 'facedown' ? '?' : card.symbol }}\n            <!-- Falls du lieber die ID sehen willst:\n                 {{ card.state === 'facedown' ? '?' : card.id }} -->\n          </span>\n        </div>\n      </button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'MemoryBoard',\n  props: {\n    cards: {\n      type: Array,\n      default: () => []\n    }\n  },\n  emits: ['flip']\n}\n</script>\n\n"],"mappings":"AAyBA,eAAe;EACbA,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM;IACjB;EACF,CAAC;EACDC,KAAK,EAAE,CAAC,MAAM;AAChB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}