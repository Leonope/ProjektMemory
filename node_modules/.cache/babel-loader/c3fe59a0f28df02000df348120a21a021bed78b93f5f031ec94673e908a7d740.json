ntBlock(\"div\", _hoisted_2, [_cache[6] || (_cache[6] = _createElementVNode(\"h1\", {\n    class: \"mb-3 text-center\"\n  }, \"Memory – Vue SPA\", -1)), $data.message ? (_openBlock(), _createElementBlock(\"div\", _hoisted_3, _toDisplayString($data.message), 1)) : _createCommentVNode(\"\", true), _createElementVNode(\"div\", _hoisted_4, [_createElementVNode(\"section\", _hoisted_5, [_createVNode(_component_GameStatusBar, {\n    \"player-name\": $data.playerName,\n    \"player-count\": $data.playerCount,\n    pairs: $data.pairs,\n    moves: $data.moves,\n    found: $data.found\n  }, null, 8, [\"player-name\", \"player-count\", \"pairs\", \"moves\", \"found\"]), _createElementVNode(\"div\", _hoisted_6, [_cache[4] || (_cache[4] = _createElementVNode(\"h5\", {\n    class: \"mb-2\"\n  }, \"Spielinfo\", -1)), _cache[5] || (_cache[5] = _createElementVNode(\"p\", {\n    class: \"mb-1\"\n  }, \"Drehe zwei Karten um. Gleiches Symbol → Paar bleibt offen.\", -1)), _createElementVNode(\"p\", _hoisted_7, \"Ziel: Finde alle \" + _toDisplayString($data.pairs) + \" Paare mit möglichst wenigen Versuchen.\", 1)]), !$data.isOnline ? (_openBlock(), _createElementBlock(\"div\", _hoisted_8, \" ⚠️ Du bist offline. Backend-Calls werden übersprungen – Spiel läuft lokal. \")) : _createCommentVNode(\"\", true)]), _createElementVNode(\"section\", _hoisted_9, [_createElementVNode(\"div\", _hoisted_10, [_createVNode(_component_MemoryBoard, {\n    cards: $data.cards,\n    onFlip: $options.flipCard\n  }, null, 8, [\"cards\", \"onFlip\"])]), _createElementVNode(\"div\", _hoisted_11, [_createElementVNode(\"button\", {\n    class: \"btn btn-outline-secondary me-2\",\n    onClick: _cache[3] || (_cache[3] = $event => $data.showSetup = true)\n  }, \" Neues Spiel konfigurieren \"), $options.allMatched ? (_openBlock(), _createElementBlock(\"span\", _hoisted_12, \" 🎉 Alle Paare gefunden! \")) : _createCommentVNode(\"\", true)])])])]))]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","$data","showSetup","_createBlock","_component_GameSetup","playerName","playerCount","pairs","_cache","val","onStart","$options","startGame","_hoisted_2","_createElementVNode","message","_hoisted_3","_toDisplayString","_hoisted_4","_hoisted_5","_createVNode","_component_GameStatusBar","moves","found","_hoisted_6","_hoisted_7","isOnline","_hoisted_8","_hoisted_9","_hoisted_10","_component_MemoryBoard","cards","onFlip","flipCard","_hoisted_11","onClick","$event","allMatched","_hoisted_12"],"sources":["C:\\Users\\leo11\\OneDrive\\Desktop\\HTWG\\AIN\\Semester5\\Web-apps\\vue\\ProjektMemory\\src\\components\\memory\\MemoryApp.vue"],"sourcesContent":["<template>\r\n  <div class=\"memory-app-container\">\r\n    <!-- Setup -->\r\n    <GameSetup\r\n      v-if=\"showSetup\"\r\n      :player-name=\"playerName\"\r\n      :player-count=\"playerCount\"\r\n      :pairs=\"pairs\"\r\n      @update:playerName=\"(val) => (playerName = val)\"\r\n      @update:playerCount=\"(val) => (playerCount = val)\"\r\n      @update:pairs=\"(val) => (pairs = val)\"\r\n      @start=\"startGame\"\r\n    />\r\n\r\n    <!-- Spiel -->\r\n    <div v-else class=\"game-container\">\r\n      <h1 class=\"mb-3 text-center\">Memory – Vue SPA</h1>\r\n\r\n      <div v-if=\"message\" class=\"alert alert-info text-center mb-3\">\r\n        {{ message }}\r\n      </div>\r\n\r\n      <div class=\"game-layout\">\r\n        <section class=\"game-sidebar\">\r\n          <GameStatusBar\r\n            :player-name=\"playerName\"\r\n            :player-count=\"playerCount\"\r\n            :pairs=\"pairs\"\r\n            :moves=\"moves\"\r\n            :found=\"found\"\r\n          />\r\n\r\n          <div class=\"info-box mt-3\">\r\n            <h5 class=\"mb-2\">Spielinfo</h5>\r\n            <p class=\"mb-1\">Drehe zwei Karten um. Gleiches Symbol → Paar bleibt offen.</p>\r\n            <p class=\"mb-0\">Ziel: Finde alle {{ pairs }} Paare mit möglichst wenigen Versuchen.</p>\r\n          </div>\r\n\r\n          <div v-if=\"!isOnline\" class=\"offline-box mt-3\">\r\n            ⚠️ Du bist offline. Backend-Calls werden übersprungen – Spiel läuft lokal.\r\n          </div>\r\n        </section>\r\n\r\n        <section class=\"game-main\">\r\n          <div class=\"board-wrapper\">\r\n            <MemoryBoard :cards=\"cards\" @flip=\"flipCard\" />\r\n          </div>\r\n\r\n          <div class=\"controls text-center mt-3\">\r\n            <button class=\"btn btn-outline-secondary me-2\" @click=\"showSetup = true\">\r\n              Neues Spiel konfigurieren\r\n            </button>\r\n            <span v-if=\"allMatched\" class=\"ms-2 text-success fw-bold\">\r\n              🎉 Alle Paare gefunden!\r\n            </span>\r\n          </div>\r\n        </section>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport GameSetup from './GameSetup.vue'\r\nimport GameStatusBar from './GameStatusBar.vue'\r\nimport MemoryBoard from './MemoryBoard.vue'\r\n\r\nexport default {\r\n  name: 'MemoryApp',\r\n  components: {\r\n    GameSetup,\r\n    GameStatusBar,\r\n    MemoryBoard\r\n  },\r\n  data() {\r\n    return {\r\n      showSetup: true,\r\n      playerName: '',\r\n      playerCount: 1,\r\n      pairs: 4,\r\n\r\n      moves: 0,\r\n      found: 0,\r\n\r\n      cards: [],\r\n      firstPick: null,\r\n      secondPick: null,\r\n      lock: false,\r\n\r\n      message: 'Willkommen bei der Vue-Version von Memory!',\r\n\r\n      isOnline: navigator.onLine\r\n    }\r\n  },\r\n  computed: {\r\n    allMatched() {\r\n      return this.found === this.pairs\r\n    }\r\n  },\r\n  mounted() {\r\n    // Online/Offline Status live updaten\r\n    window.addEventListener('online', this.handleOnline)\r\n    window.addEventListener('offline', this.handleOffline)\r\n  },\r\n  beforeUnmount() {\r\n    window.removeEventListener('online', this.handleOnline)\r\n    window.removeEventListener('offline', this.handleOffline)\r\n  },\r\n  methods: {\r\n    handleOnline() {\r\n      this.isOnline = true\r\n      this.message = '✅ Wieder online.'\r\n    },\r\n    handleOffline() {\r\n      this.isOnline = false\r\n      this.message = '⚠️ Offline: Server nicht erreichbar. Spiel läuft lokal.'\r\n    },\r\n\r\n    buildDeck(pairs) {\r\n      const base = Array.from({ length: pairs }, (_, i) => String(i + 1))\r\n      const doppelt = base.concat(base)\r\n      for (let i = doppelt.length - 1; i > 0; i--) {\r\n        const j = Math.floor(Math.random() * (i + 1))\r\n        ;[doppelt[i], doppelt[j]] = [doppelt[j], doppelt[i]]\r\n      }\r\n      return doppelt\r\n    },\r\n\r\n    initGame() {\r\n      const deck = this.buildDeck(this.pairs)\r\n      this.cards = deck.map((sym, idx) => ({\r\n        id: idx,\r\n        symbol: sym,\r\n        state: 'facedown'\r\n      }))\r\n      this.moves = 0\r\n      this.found = 0\r\n      this.firstPick = null\r\n      this.secondPick = null\r\n      this.lock = false\r\n    },\r\n\r\n    notifyBackendStart() {\r\n      if (!this.isOnline) {\r\n        // offline: skip backend\r\n        return\r\n      }\r\n\r\n      const name =\r\n        this.playerName && this.playerName.trim().length > 0\r\n          ? this.playerName.trim()\r\n          : 'Player'\r\n\r\n      fetch('/game/vue/start', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({\r\n          playerName: name,\r\n          playerCount: this.playerCount,\r\n          pairs: this.pairs\r\n        })\r\n      })\r\n        .then((res) => res.json().catch(() => null))\r\n        .catch(() => {\r\n          this.message = '⚠️ Server nicht erreichbar (Play Backend). Spiel läuft lokal.'\r\n        })\r\n    },\r\n\r\n    startGame() {\r\n      this.initGame()\r\n      this.showSetup = false\r\n      this.message = `Vue-Spiel für ${this.playerName || 'Player'} mit ${this.pairs} Paar(en) gestartet.`\r\n      this.notifyBackendStart()\r\n    },\r\n\r\n    flipCard(index) {\r\n      if (this.lock) return\r\n      const c = this.cards[index]\r\n      if (!c || c.state !== 'facedown') return\r\n\r\n      c.state = 'faceup'\r\n\r\n      if (!this.firstPick) {\r\n        this.firstPick = { index, symbol: c.symbol }\r\n        return\r\n      }\r\n\r\n      this.secondPick = { index, symbol: c.symbol }\r\n      this.lock = true\r\n      this.moves++\r\n\r\n      if (this.firstPick.symbol === this.secondPick.symbol) {\r\n        setTimeout(() => {\r\n          this.cards[this.firstPick.index].state = 'matched'\r\n          this.cards[this.secondPick.index].state = 'matched'\r\n          this.found++\r\n\r\n          this.firstPick = null\r\n          this.secondPick = null\r\n          this.lock = false\r\n        }, 250)\r\n      } else {\r\n        setTimeout(() => {\r\n          this.cards[this.firstPick.index].state = 'facedown'\r\n          this.cards[this.secondPick.index].state = 'facedown'\r\n\r\n          this.firstPick = null\r\n          this.secondPick = null\r\n          this.lock = false\r\n        }, 600)\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.memory-app-container {\r\n  max-width: 1100px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.game-container {\r\n  background: #f8f9fa;\r\n  border-radius: 1rem;\r\n  padding: 1.5rem;\r\n  box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.game-layout {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.5rem;\r\n}\r\n\r\n.game-sidebar {\r\n  flex: 0 0 280px;\r\n}\r\n\r\n.game-main {\r\n  flex: 1;\r\n}\r\n\r\n.board-wrapper {\r\n  background: white;\r\n  border-radius: 1rem;\r\n  padding: 1rem;\r\n  box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.04);\r\n}\r\n\r\n.info-box {\r\n  background: white;\r\n  border-radius: 0.75rem;\r\n  padding: 0.75rem 1rem;\r\n  box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.04);\r\n  font-size: 0.9rem;\r\n}\r\n\r\n.offline-box {\r\n  background: #fff3cd;\r\n  border: 1px solid #ffeeba;\r\n  color: #856404;\r\n  border-radius: 0.75rem;\r\n  padding: 0.75rem 1rem;\r\n  font-size: 0.9rem;\r\n}\r\n\r\n@media (min-width: 900px) {\r\n  .game-layout {\r\n    flex-direction: row;\r\n    align-items: flex-start;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,KAAK,EAAC;AAAsB;;;EAcnBA,KAAK,EAAC;;;;EAGIA,KAAK,EAAC;;;EAIrBA,KAAK,EAAC;AAAa;;EACbA,KAAK,EAAC;AAAc;;EAStBA,KAAK,EAAC;AAAe;;EAGrBA,KAAK,EAAC;AAAM;;;EAGKA,KAAK,EAAC;;;EAKrBA,KAAK,EAAC;AAAW;;EACnBA,KAAK,EAAC;AAAe;;EAIrBA,KAAK,EAAC;AAA2B;;;EAIZA,KAAK,EAAC;;;;;;uBAnDxCC,mBAAA,CA0DM,OA1DNC,UA0DM,GAvDIC,KAAA,CAAAC,SAAS,I,cADjBC,YAAA,CASEC,oBAAA;;IAPC,aAAW,EAAEH,KAAA,CAAAI,UAAU;IACvB,cAAY,EAAEJ,KAAA,CAAAK,WAAW;IACzBC,KAAK,EAAEN,KAAA,CAAAM,KAAK;IACZ,qBAAiB,EAAAC,MAAA,QAAAA,MAAA,MAAGC,GAAG,IAAMR,KAAA,CAAAI,UAAU,GAAGI,GAAG;IAC7C,sBAAkB,EAAAD,MAAA,QAAAA,MAAA,MAAGC,GAAG,IAAMR,KAAA,CAAAK,WAAW,GAAGG,GAAG;IAC/C,gBAAY,EAAAD,MAAA,QAAAA,MAAA,MAAGC,GAAG,IAAMR,KAAA,CAAAM,KAAK,GAAGE,GAAG;IACnCC,OAAK,EAAEC,QAAA,CAAAC;qFAIVb,mBAAA,CA2CM,OA3CNc,UA2CM,G,0BA1CJC,mBAAA,CAAkD;IAA9ChB,KAAK,EAAC;EAAkB,GAAC,kBAAgB,QAElCG,KAAA,CAAAc,OAAO,I,cAAlBhB,mBAAA,CAEM,OAFNiB,UAEM,EAAAC,gBAAA,CADDhB,KAAA,CAAAc,OAAO,S,+BAGZD,mBAAA,CAmCM,OAnCNI,UAmCM,GAlCJJ,mBAAA,CAkBU,WAlBVK,UAkBU,GAjBRC,YAAA,CAMEC,wBAAA;IALC,aAAW,EAAEpB,KAAA,CAAAI,UAAU;IACvB,cAAY,EAAEJ,KAAA,CAAAK,WAAW;IACzBC,KAAK,EAAEN,KAAA,CAAAM,KAAK;IACZe,KAAK,EAAErB,KAAA,CAAAqB,KAAK;IACZC,KAAK,EAAEtB,KAAA,CAAAsB;2EAGVT,mBAAA,CAIM,OAJNU,UAIM,G,0BAHJV,mBAAA,CAA+B;IAA3BhB,KAAK,EAAC;EAAM,GAAC,WAAS,Q,0BAC1BgB,mBAAA,CAA8E;IAA3EhB,KAAK,EAAC;EAAM,GAAC,4DAA0D,QAC1EgB,mBAAA,CAAuF,KAAvFW,UAAuF,EAAvE,mBAAiB,GAAAR,gBAAA,CAAGhB,KAAA,CAAAM,KAAK,IAAG,yCAAuC,K,IAGzEN,KAAA,CAAAyB,QAAQ,I,cAApB3B,mBAAA,CAEM,OAFN4B,UAEM,EAFyC,8EAE/C,K,iCAGFb,mBAAA,CAaU,WAbVc,UAaU,GAZRd,mBAAA,CAEM,OAFNe,WAEM,GADJT,YAAA,CAA+CU,sBAAA;IAAjCC,KAAK,EAAE9B,KAAA,CAAA8B,KAAK;IAAGC,MAAI,EAAErB,QAAA,CAAAsB;sCAGrCnB,mBAAA,CAOM,OAPNoB,WAOM,GANJpB,mBAAA,CAES;IAFDhB,KAAK,EAAC,gCAAgC;IAAEqC,OAAK,EAAA3B,MAAA,QAAAA,MAAA,MAAA4B,MAAA,IAAEnC,KAAA,CAAAC,SAAS;KAAS,6BAEzE,GACYS,QAAA,CAAA0B,UAAU,I,cAAtB