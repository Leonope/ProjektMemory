{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport GameSetup from './GameSetup.vue';\nimport GameStatusBar from './GameStatusBar.vue';\nimport MemoryBoard from './MemoryBoard.vue';\nexport default {\n  name: 'MemoryApp',\n  components: {\n    GameSetup,\n    GameStatusBar,\n    MemoryBoard\n  },\n  data() {\n    return {\n      showSetup: true,\n      playerName: '',\n      playerCount: 1,\n      pairs: 4,\n      moves: 0,\n      found: 0,\n      cards: [],\n      firstPick: null,\n      secondPick: null,\n      lock: false,\n      message: 'Willkommen bei der Vue-Version von Memory!'\n    };\n  },\n  computed: {\n    allMatched() {\n      return this.found === this.pairs;\n    }\n  },\n  methods: {\n    buildDeck(pairs) {\n      const base = Array.from({\n        length: pairs\n      }, (_, i) => String(i + 1));\n      const doppelt = base.concat(base);\n      for (let i = doppelt.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [doppelt[i], doppelt[j]] = [doppelt[j], doppelt[i]];\n      }\n      return doppelt;\n    },\n    initGame() {\n      const deck = this.buildDeck(this.pairs);\n      this.cards = deck.map((sym, idx) => ({\n        id: idx,\n        symbol: sym,\n        state: 'facedown'\n      }));\n      this.moves = 0;\n      this.found = 0;\n      this.firstPick = null;\n      this.secondPick = null;\n      this.lock = false;\n    },\n    notifyBackendStart() {\n      const name = this.playerName && this.playerName.trim().length > 0 ? this.playerName.trim() : 'Player';\n      fetch('/game/vue/start', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json'\n        },\n        body: JSON.stringify({\n          playerName: name,\n          playerCount: this.playerCount,\n          pairs: this.pairs\n        })\n      }).then(res => res.json().catch(() => null)).catch(err => console.error('Fehler bei /game/vue/start:', err));\n    },\n    startGame() {\n      this.initGame();\n      this.showSetup = false;\n      this.message = `Vue-Spiel für ${this.playerName || 'Player'} mit ${this.pairs} Paar(en) gestartet.`;\n      this.notifyBackendStart();\n    },\n    flipCard(index) {\n      if (this.lock) return;\n      const c = this.cards[index];\n      if (!c || c.state !== 'facedown') return;\n      c.state = 'faceup';\n      if (!this.firstPick) {\n        this.firstPick = {\n          index,\n          symbol: c.symbol\n        };\n        return;\n      }\n      this.secondPick = {\n        index,\n        symbol: c.symbol\n      };\n      this.lock = true;\n      this.moves++;\n      if (this.firstPick.symbol === this.secondPick.symbol) {\n        setTimeout(() => {\n          this.cards[this.firstPick.index].state = 'matched';\n          this.cards[this.secondPick.index].state = 'matched';\n          this.found++;\n          this.firstPick = null;\n          this.secondPick = null;\n          this.lock = false;\n        }, 250);\n      } else {\n        setTimeout(() => {\n          this.cards[this.firstPick.index].state = 'facedown';\n          this.cards[this.secondPick.index].state = 'facedown';\n          this.firstPick = null;\n          this.secondPick = null;\n          this.lock = false;\n        }, 600);\n      }\n    }\n  }\n};","map":{"version":3,"names":["GameSetup","GameStatusBar","MemoryBoard","name","components","data","showSetup","playerName","playerCount","pairs","moves","found","cards","firstPick","secondPick","lock","message","computed","allMatched","methods","buildDeck","base","Array","from","length","_","i","String","doppelt","concat","j","Math","floor","random","initGame","deck","map","sym","idx","id","symbol","state","notifyBackendStart","trim","fetch","method","headers","body","JSON","stringify","then","res","json","catch","err","console","error","startGame","flipCard","index","c","setTimeout"],"sources":["C:\\Users\\leo11\\OneDrive\\Desktop\\HTWG\\AIN\\Semester5\\Web-apps\\vue\\ProjektMemory\\src\\components\\memory\\MemoryApp.vue"],"sourcesContent":["<template>\r\n  <div class=\"memory-app-container\">\r\n    <!-- Setup-Ansicht -->\r\n    <GameSetup\r\n      v-if=\"showSetup\"\r\n      :player-name=\"playerName\"\r\n      :player-count=\"playerCount\"\r\n      :pairs=\"pairs\"\r\n      @update:playerName=\"val => playerName = val\"\r\n      @update:playerCount=\"val => playerCount = val\"\r\n      @update:pairs=\"val => pairs = val\"\r\n      @start=\"startGame\"\r\n    />\r\n\r\n    <!-- Spiel-Ansicht -->\r\n    <div v-else class=\"game-container\">\r\n      <h1 class=\"mb-3 text-center\">Memory – Vue SPA</h1>\r\n\r\n      <div class=\"game-layout\">\r\n        <!-- Linke Seite: Status + Message -->\r\n        <section class=\"game-sidebar\">\r\n          <div v-if=\"message\" class=\"alert alert-info text-center mb-3\">\r\n            {{ message }}\r\n          </div>\r\n\r\n          <GameStatusBar\r\n            :player-name=\"playerName\"\r\n            :player-count=\"playerCount\"\r\n            :pairs=\"pairs\"\r\n            :moves=\"moves\"\r\n            :found=\"found\"\r\n          />\r\n\r\n          <div class=\"info-box mt-3\">\r\n            <h5 class=\"mb-2\">Spielinfo</h5>\r\n            <p class=\"mb-1\">\r\n              Drehe zwei Karten um. Sind die Symbole gleich, bleibt das Paar aufgedeckt.\r\n            </p>\r\n            <p class=\"mb-0\">\r\n              Ziel: Finde alle {{ pairs }} Paare mit möglichst wenigen Versuchen.\r\n            </p>\r\n          </div>\r\n        </section>\r\n\r\n        <!-- Rechte Seite: Spielfeld -->\r\n        <section class=\"game-main\">\r\n          <div class=\"board-wrapper\">\r\n            <MemoryBoard\r\n              :cards=\"cards\"\r\n              @flip=\"flipCard\"\r\n            />\r\n          </div>\r\n\r\n          <div class=\"controls text-center mt-3\">\r\n            <button class=\"btn btn-outline-secondary me-2\" @click=\"showSetup = true\">\r\n              Neues Spiel konfigurieren\r\n            </button>\r\n            <span v-if=\"allMatched\" class=\"ms-2 text-success fw-bold\">\r\n              🎉 Alle Paare gefunden!\r\n            </span>\r\n          </div>\r\n        </section>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport GameSetup from './GameSetup.vue'\r\nimport GameStatusBar from './GameStatusBar.vue'\r\nimport MemoryBoard from './MemoryBoard.vue'\r\n\r\nexport default {\r\n  name: 'MemoryApp',\r\n  components: {\r\n    GameSetup,\r\n    GameStatusBar,\r\n    MemoryBoard\r\n  },\r\n  data() {\r\n    return {\r\n      showSetup: true,\r\n      playerName: '',\r\n      playerCount: 1,\r\n      pairs: 4,\r\n\r\n      moves: 0,\r\n      found: 0,\r\n\r\n      cards: [],\r\n      firstPick: null,\r\n      secondPick: null,\r\n      lock: false,\r\n\r\n      message: 'Willkommen bei der Vue-Version von Memory!'\r\n    }\r\n  },\r\n  computed: {\r\n    allMatched() {\r\n      return this.found === this.pairs\r\n    }\r\n  },\r\n  methods: {\r\n    buildDeck(pairs) {\r\n      const base = Array.from({ length: pairs }, (_, i) => String(i + 1))\r\n      const doppelt = base.concat(base)\r\n      for (let i = doppelt.length - 1; i > 0; i--) {\r\n        const j = Math.floor(Math.random() * (i + 1))\r\n        ;[doppelt[i], doppelt[j]] = [doppelt[j], doppelt[i]]\r\n      }\r\n      return doppelt\r\n    },\r\n    initGame() {\r\n      const deck = this.buildDeck(this.pairs)\r\n      this.cards = deck.map((sym, idx) => ({\r\n        id: idx,\r\n        symbol: sym,\r\n        state: 'facedown'\r\n      }))\r\n      this.moves = 0\r\n      this.found = 0\r\n      this.firstPick = null\r\n      this.secondPick = null\r\n      this.lock = false\r\n    },\r\n    notifyBackendStart() {\r\n      const name =\r\n        this.playerName && this.playerName.trim().length > 0\r\n          ? this.playerName.trim()\r\n          : 'Player'\r\n\r\n      fetch('/game/vue/start', {\r\n        method: 'POST',\r\n        headers: {\r\n          'Content-Type': 'application/json'\r\n        },\r\n        body: JSON.stringify({\r\n          playerName: name,\r\n          playerCount: this.playerCount,\r\n          pairs: this.pairs\r\n        })\r\n      })\r\n        .then(res => res.json().catch(() => null))\r\n        .catch(err => console.error('Fehler bei /game/vue/start:', err))\r\n    },\r\n    startGame() {\r\n      this.initGame()\r\n      this.showSetup = false\r\n      this.message = `Vue-Spiel für ${this.playerName || 'Player'} mit ${this.pairs} Paar(en) gestartet.`\r\n      this.notifyBackendStart()\r\n    },\r\n    flipCard(index) {\r\n      if (this.lock) return\r\n      const c = this.cards[index]\r\n      if (!c || c.state !== 'facedown') return\r\n\r\n      c.state = 'faceup'\r\n\r\n      if (!this.firstPick) {\r\n        this.firstPick = { index, symbol: c.symbol }\r\n        return\r\n      }\r\n\r\n      this.secondPick = { index, symbol: c.symbol }\r\n      this.lock = true\r\n      this.moves++\r\n\r\n      if (this.firstPick.symbol === this.secondPick.symbol) {\r\n        setTimeout(() => {\r\n          this.cards[this.firstPick.index].state = 'matched'\r\n          this.cards[this.secondPick.index].state = 'matched'\r\n          this.found++\r\n\r\n          this.firstPick = null\r\n          this.secondPick = null\r\n          this.lock = false\r\n        }, 250)\r\n      } else {\r\n        setTimeout(() => {\r\n          this.cards[this.firstPick.index].state = 'facedown'\r\n          this.cards[this.secondPick.index].state = 'facedown'\r\n\r\n          this.firstPick = null\r\n          this.secondPick = null\r\n          this.lock = false\r\n        }, 600)\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.memory-app-container {\r\n  max-width: 1100px;\r\n  margin: 0 auto;\r\n}\r\n\r\n/* Bereich, in dem das eigentliche Spiel dargestellt wird */\r\n.game-container {\r\n  background: #f8f9fa;\r\n  border-radius: 1rem;\r\n  padding: 1.5rem;\r\n  box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n/* Layout: auf großen Screens 2 Spalten, auf Handy untereinander */\r\n.game-layout {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.5rem;\r\n}\r\n\r\n.game-sidebar {\r\n  flex: 0 0 280px;\r\n}\r\n\r\n.game-main {\r\n  flex: 1;\r\n}\r\n\r\n/* Board hübsch einrahmen */\r\n.board-wrapper {\r\n  background: white;\r\n  border-radius: 1rem;\r\n  padding: 1rem;\r\n  box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.04);\r\n}\r\n\r\n/* Info-Karte links */\r\n.info-box {\r\n  background: white;\r\n  border-radius: 0.75rem;\r\n  padding: 0.75rem 1rem;\r\n  box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.04);\r\n  font-size: 0.9rem;\r\n}\r\n\r\n/* Ab einer gewissen Breite nebeneinander */\r\n@media (min-width: 900px) {\r\n  .game-layout {\r\n    flex-direction: row;\r\n    align-items: flex-start;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;;AAoEA,OAAOA,SAAQ,MAAO,iBAAgB;AACtC,OAAOC,aAAY,MAAO,qBAAoB;AAC9C,OAAOC,WAAU,MAAO,mBAAkB;AAE1C,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVJ,SAAS;IACTC,aAAa;IACbC;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,IAAI;MACfC,UAAU,EAAE,EAAE;MACdC,WAAW,EAAE,CAAC;MACdC,KAAK,EAAE,CAAC;MAERC,KAAK,EAAE,CAAC;MACRC,KAAK,EAAE,CAAC;MAERC,KAAK,EAAE,EAAE;MACTC,SAAS,EAAE,IAAI;MACfC,UAAU,EAAE,IAAI;MAChBC,IAAI,EAAE,KAAK;MAEXC,OAAO,EAAE;IACX;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,OAAO,IAAI,CAACP,KAAI,KAAM,IAAI,CAACF,KAAI;IACjC;EACF,CAAC;EACDU,OAAO,EAAE;IACPC,SAASA,CAACX,KAAK,EAAE;MACf,MAAMY,IAAG,GAAIC,KAAK,CAACC,IAAI,CAAC;QAAEC,MAAM,EAAEf;MAAM,CAAC,EAAE,CAACgB,CAAC,EAAEC,CAAC,KAAKC,MAAM,CAACD,CAAA,GAAI,CAAC,CAAC;MAClE,MAAME,OAAM,GAAIP,IAAI,CAACQ,MAAM,CAACR,IAAI;MAChC,KAAK,IAAIK,CAAA,GAAIE,OAAO,CAACJ,MAAK,GAAI,CAAC,EAAEE,CAAA,GAAI,CAAC,EAAEA,CAAC,EAAE,EAAE;QAC3C,MAAMI,CAAA,GAAIC,IAAI,CAACC,KAAK,CAACD,IAAI,CAACE,MAAM,CAAC,KAAKP,CAAA,GAAI,CAA