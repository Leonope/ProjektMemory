# API Endpoints for Vue frontend
POST  /cmd              controllers.GameController.cmd
POST  /new              controllers.GameController.newGame
POST  /quit             controllers.GameController.quit
GET   /state            controllers.GameController.state
GET   /test             controllers.GameController.test
GET   /game-matrix      controllers.GameController.getXml
GET   /game/preset/:key controllers.GameController.preset(key: String)
GET   /game/highscores  controllers.GameController.getHighscoresJson
POST  /game/highscore   controllers.GameController.submitHighscore
GET   /ws/game          controllers.GameController.gameSocket
GET   /game/chat/comet  controllers.ChatController.chatComet(sessionId: String)
POST  /game/chat/send   controllers.ChatController.chatSend
GET   /sse/sessions     controllers.SseController.sessionsStream
POST  /api/log          controllers.ApiController.logLine

# (Optional) Static assets, if needed
GET   /assets/*file     controllers.Assets.versioned(path="/public", file: Asset)